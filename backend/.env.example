# copy to backend/.env and fill in:  cp .env.example .env

# --- core ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# comma separated allowlist. empty = allow all in development, none in production
CORS_ORIGINS=

# --- database (required) ---------------------------------------------------
# docker compose:  postgres://swiftdrop:swiftdrop@postgres:5432/swiftdrop
# neon / hosted:   postgres://USER:PASSWORD@HOST/DB
DATABASE_URL=postgres://swiftdrop:swiftdrop@localhost:5432/swiftdrop
# require for neon / hosted postgres, disable for local postgres
DATABASE_SSL=disable

# --- redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- auth (required) -------------------------------------------------------
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# --- sms (fast2sms) ----------------------------------------------------------
# outside production the OTP is written to the log instead of being sent
FAST2SMS_API_KEY=

# --- maps (ola maps) ---------------------------------------------------------
# outside production a missing key falls back to a mock distance
OLA_MAPS_API_KEY=

# --- payments (razorpay) -----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- cloudinary (driver document uploads) ------------------------------------
# outside production a missing cloud name skips the upload and stores a placeholder url
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
