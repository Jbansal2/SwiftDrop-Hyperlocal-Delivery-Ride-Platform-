{
  "name": "backend",
  "version": "1.1.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "NODE_ENV=test node --test",
    "test:coverage": "NODE_ENV=test node --test --experimental-test-coverage --test-coverage-lines=75 --test-coverage-include=src/**",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate": "node src/db/migrate.js",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "SwiftDrop Backend",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "axios": "^1.13.6",
    "cloudinary": "^2.9.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.8.2",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "postgres": "^3.4.8",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "ioredis-mock": "^8.13.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
